# Smart Retail AI Platform - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

SMART_RETAIL_APP_NAME="AI-Powered Smart Retail & Customer Intelligence Platform"
SMART_RETAIL_APP_VERSION="1.2.0"
SMART_RETAIL_ENV="development"
SMART_RETAIL_LOG_LEVEL="INFO"

# Upload and Image Dimension Limits
SMART_RETAIL_MAX_IMAGE_BYTES=5242880
SMART_RETAIL_MIN_IMAGE_DIM=10
SMART_RETAIL_MAX_IMAGE_DIM=4096

# Model & Asset Paths (relative to project root or absolute paths)
SMART_RETAIL_PRODUCT_MODEL="models/product_classifier.joblib"
SMART_RETAIL_SENTIMENT_MODEL="models/sentiment_classifier.joblib"
SMART_RETAIL_FACE_DB="models/face_db.pkl"
SMART_RETAIL_CASCADE_PATH="data/haarcascades/haarcascade_frontalface_default.xml"
SMART_RETAIL_KNOWLEDGE_PATH="data/chatbot/retail_knowledge.json"
